{
  "name": "campus-credits-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0 <23" },
  "scripts": {
    "prepare:kit": "npm --prefix chaincode ci",
    "check": "bash scripts/check.sh",
    "network": "bash scripts/network.sh",
    "deploy": "bash scripts/deploy.sh",
    "start": "node server.mjs",
    "use:starter": "node scripts/select-rules.mjs starter",
    "use:solution": "node scripts/select-rules.mjs solution",
    "reset:network": "bash scripts/reset.sh",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@hyperledger/fabric-gateway": "1.13.0"
  }
}
